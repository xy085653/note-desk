/* CardNote 日间主题 */
QTextEdit {
    background: transparent;
    color: #2c2c2c;
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 14px;
    line-height: 1.6;
    selection-background-color: #4a90d9;
    selection-color: white;
}

QTextEdit:focus {
    background: rgba(255, 255, 255, 0.3);
}

QMenu {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
    font-size: 13px;
}

QMenu::item:selected {
    background: #f0f0f0;
}

QMenu::separator {
    height: 1px;
    background: #e8e8e8;
    margin: 4px 12px;
}

QSizeGrip {
    background: rgba(0, 0, 0, 0.1);
    border-bottom-right-radius: 8px;
}
